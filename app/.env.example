# 이 파일을 .env.local로 복사해서 값을 채운다. .env.local은 git에 올라가지 않는다 (HANDOFF 10절).
# VITE_ 로 시작하는 값만 브라우저로 간다. 브라우저에 보내도 되는 값에만 VITE_를 붙인다.

# ── 브라우저에 보내도 되는 값 (채팅·문서에 있어도 됨) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_KAKAO_JS_KEY=

# ── 서버 전용 (VITE_ 금지, 채팅·문서에 붙이지 않음) ──
# 개발 서버의 /api/* (app/server/)가 쓴다. 배포 때는 Vercel 프로젝트 환경 변수에 직접 넣는다.
# DB 작업(scripts/prep/apply_migrations.py, load_db.py)을 할 사람만 SUPABASE_DB_PASSWORD를 운영자에게 따로 받는다.
KAKAO_REST_KEY=
BAZE_API_KEY=
BAZE_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway
BAZE_MODEL=gpt-6-luna
